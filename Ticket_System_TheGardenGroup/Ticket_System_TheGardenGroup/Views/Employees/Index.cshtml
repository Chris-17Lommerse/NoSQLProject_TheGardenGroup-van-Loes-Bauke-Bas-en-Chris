@model List<Employee>
@{
    ViewData["Title"] = "Employees";
}

<h1 class="alert-danger">@TempData["ErrorMessage"]</h1>
<h1 class="alert-warning">@TempData["WarningMessage"]</h1>
<h1 class="alert-success">@TempData["SuccesMessage"]</h1>
<h1 class="alert-danger">@TempData["EmbddEmpl"]</h1>

<div class="text-center">
    <h1>User Management</h1>
    <a href="/Employees/AddEmployee" class="btn btn-primary">Create New Employee</a>

    <table class="table table-info table-hover">
        <partial name="_EmployeesHeader" />
        <tbody>
            @foreach(Employee employee in Model)
            {
                <tr>
                    <td>@employee.EmployeeNumber</td>
                    <td>@employee.EmailAddress</td>
                    <td>@employee.Name</td>
                    <td>@employee.Surname</td>
                    <td>@employee.EmployeeRole</td>
                    <td>@employee.Id</td>
                    <td>
                        <a href="/Employees/ViewEmployee/@employee.Id">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
