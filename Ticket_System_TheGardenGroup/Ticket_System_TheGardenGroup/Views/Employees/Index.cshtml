@using Ticket_System_TheGardenGroup.ViewModels;
@model Task<List<EmployeeTicketsViewModel>>
@{
    ViewData["Title"] = "Employees";
}

<div class="text-center">
    <h1>User Management</h1>

    <table class="table table-info table-hover">
        <partial name="_EmployeesHeader" />
        <tbody>
            @foreach(EmployeeTicketsViewModel employeeTicketsViewModel in await Model)
            {
                <tr>
                    <td>@employeeTicketsViewModel.EmployeeNumber.Number</td>
                    <td>@employeeTicketsViewModel.EmailAddress</td>
                    <td>@employeeTicketsViewModel.Name</td>
                    <td>@employeeTicketsViewModel.Surname</td>
                    <td>@employeeTicketsViewModel.EmployeeRole</td>
                    <td>@employeeTicketsViewModel.TotalTickets</td>
                </tr>
            }
        </tbody>
    </table>
</div>
