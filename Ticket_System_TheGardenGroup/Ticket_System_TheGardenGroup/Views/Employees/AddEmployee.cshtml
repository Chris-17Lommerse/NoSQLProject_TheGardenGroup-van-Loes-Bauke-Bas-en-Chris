@using Ticket_System_TheGardenGroup.Models.Enums
@model Employee
@{
    ViewData["Title"] = "Add Employee";
}
<h1 class="alert-danger">@TempData["ErrorMessage"]</h1>
<h1 class="alert-warning">@TempData["WarningMessage"]</h1>
<h1 class="alert-success">@TempData["SuccesMessage"]</h1>

<h2>Add New Employee</h2>
<form asp-action="AddEmployee" method="post">
    
    <div class="form-group">
        <label asp-for="EmailAddress"></label>
        <input asp-for="EmailAddress" class="form-control" required/>
        <span asp-validation-for="EmailAddress" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Surname"></label>
        <input asp-for="Surname" class="form-control" />
        <span asp-validation-for="Surname" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EmployeeRole"></label>
        <select asp-for="EmployeeRole" class="form-control" asp-items="Html.GetEnumSelectList<EmployeeRole>()" required>
            <option value="">-- Select Role --</option>
            
        </select>
        <span asp-validation-for="EmployeeRole" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input" checked />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Add Employee</button>
</form>
<a href="/Employees/Index" class="btn btn-secondary mt-3">Back to Employee List</a>
