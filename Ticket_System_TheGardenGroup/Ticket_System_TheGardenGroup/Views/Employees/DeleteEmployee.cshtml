@model Employee
@{
	ViewData["Title"] = "Delete employee";
}

<h1 class="alert-danger">@TempData["ErrorMessage"]</h1>
<h1 class="alert-warning">@TempData["WarningMessage"]</h1>
<h1 class="alert-success">@TempData["SuccesMessage"]</h1>

<h1>Edit Lecturer</h1>

<form action="/Lecturers/Edit" method="post">
	<input hidden type="text" name="ObjectID" value="@Model." />

	<section class="form-group py-2">
		<label for="Age">Age:</label>
		<input readonly type="number" id="Age" name="Age" class="form-control" required value="@Model?.Name" />
	</section>

	<section class="form-group py-2">
		<label for="Surname">Surname:</label>
		<input readonly type="text" id="Surname" name="Surname" class="form-control" required value="@Model?.Surname" />
	</section>

	<section class="form-group py-2">
		<label for="EmployeeRole">Employee role:</label>
		<input readonly type="text" id="EmployeeRole" name="EmployeeRole" class="form-control" required value="@Model?.EmployeeRole" />
	</section>

	<section class="form-group py-2">
		<label for="EmailAddress">EmailAddress:</label>
		<input readonly type="tel" id="EmailAddress" name="EmailAddress" class="form-control" required value="@Model?.EmailAddress" />
	</section>

	<section class="form-group py-2">
		<label for="IsActive">Is active?:</label>
		<input readonly type="tel" id="IsActive" name="IsActive" class="form-control" required value="@Model?.IsActive" />
	</section>

	<button type="submit" class="btn btn-primary">Delete</button>
</form>

<a href="/Lecturers/Index">Back to List</a>