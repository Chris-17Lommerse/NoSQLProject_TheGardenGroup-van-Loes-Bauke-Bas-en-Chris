<section class="d-flex flex-column align-items-center p-4" style="max-width: 400px; margin: auto;">
    <a href="img/warningSymbol.png" class="d-block mb-3 text-center">
        <img src="img/warningSymbol.png" alt="Warning" style="width: 50px; height: 50px;">
    </a>

    <p class="text-center mb-4">Do you really want to archive all tickets older then 2 years?</p>

    <div class="d-flex justify-content-center gap-3 mb-3">
        <button id="confirmBtn" class="btn btn-danger">Yes</button>
        <button id="cancelBtn" class="btn btn-secondary">No</button>
    </div>

    <section id="undoMessage" class="alert alert-success d-none text-center">
        <span>Tickets archived. <button id="undoBtn" class="btn btn-link p-0 m-0 align-baseline">Undo</button></span>
    </section>
</section>