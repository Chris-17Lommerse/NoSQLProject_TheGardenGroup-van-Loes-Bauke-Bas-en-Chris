@model Ticket

@{
    ViewData["Title"] = "Delete ticket";
}

<section>

    <a href="/Tickets/UpdateTicket?TicketId=@Model?.TicketId" class="btn btn-outline-primary mb-3">Back to edit ticket</a>

    <form action="/Tickets/DeleteTicket" method="post">
        <section>
            <label hidden for="TicketId">Ticket id</label>
            <input hidden type="text" id="TicketId" name="TicketId" class="form-control" value="@Model?.TicketId" />
        </section>

        <section>
            <label readonly for="creationTime">Creation time</label>
            <input readonly type="datetime" id="creationTime" name="CreationTime" class="form-control" value="@Model?.CreationTime" />
        </section>

        <section>
            <label readonly for="TicketStatus">Ticket Status</label>
            <input readonly type="text" id="TicketStatus" name="TicketStatus" class="form-control" value="@Model?.TicketStatus" />
        </section>

        <section>
            <label readonly for="TicketName">Ticket name</label>
            <input readonly type="text" id="TicketName" name="TicketName" class="form-control" value="@Model?.TicketName" />
        </section>

        <section>
            <label readonly for="Description">Ticket Description</label>
            <input readonly type="text" id="Description" name="Description" class="form-control" value="@Model?.Description" />
        </section>

        <section>
            <label readonly for="TicketEscalationDescription">Ticket Description</label>
            <input readonly type="text" id="TicketEscalationDescription" name="TicketEscalationDescription" class="form-control" value="@Model?.TicketEscalationDescription" />
        </section>

        <section>
            <label readonly for="IsSolved">Is ticket solved?</label>
            <input readonly type="text" id="IsSolved" name="IsSolved" class="form-control" value="@Model?.IsSolved.ToString()" />
        </section>

        <section>
            <label readonly for="ticketPriority">Ticket priority (only ds_e)</label>
            <input readonly type="text" id="ticketPriority" name="ticketPriority" class="form-control" value="@Model?.Priority" />
        </section>

        <section>
            <label readonly for="reportEmployee">Reporting employee</label>
            <input readonly type="text" id="reportEmployee" name="reportEmployee" class="form-control" value="@Model?.ReportingEmployee.Name" />
        </section>

        <section>
            <label readonly for="solvEmployee">Solving Employee Number</label>
            <input readonly type="text" id="solvEmployee" name="SolvingEmployeeNumber" class="form-control" value="@Model?.SolvingEmployee.EmployeeNumber" />
        </section>

        <section>
            <label readonly>Name</label>
            <input readonly type="text" class="form-control" value="@Model?.SolvingEmployee.Name" />
        </section>

        <section>
            <label readonly>Email</label>
            <input readonly type="text" class="form-control" value="@Model?.SolvingEmployee.EmailAddress" />
        </section>

        <section>
            <label readonly>Role</label>
            <input readonly type="text" class="form-control" value="@Model?.SolvingEmployee.EmployeeRole" />
        </section>

        <button type="submit" class="btn btn-danger">Delete ticket</button>

    </form>
</section>
