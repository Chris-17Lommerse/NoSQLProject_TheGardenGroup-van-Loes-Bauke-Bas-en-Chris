@using Ticket_System_TheGardenGroup_With_Identity_Framework.ViewModels;
@model EmployeeViewModel
@{
	ViewData["Title"] = "ViewEmployee";
}

<partial name="_ErrorMessage" />
<partial name="_WarningMessage" />
<partial name="_SuccessMessage" />

<a href="/Employees/Index" class="btn btn-primary mb-3">Back to employee list</a>
<a href="/Employees/UpdateEmployee?employeeIdString=@Model?.Id" class="btn mb-3 btn-warning">Update employee</a>
<a href="/Employees/DeleteEmployee?employeeId=@Model?.Id" class="btn mb-3 btn-danger">Delete employee</a>

<section>

    
    <section>
        <label hidden for="EmployeeId">Employee Id</label>
        <input readonly hidden type="text" id="EmployeeId" name="Id" class="form-control" value="@Model?.Id" />
    </section>

    <section>
        <label readonly for="Name">Name</label>
        <input readonly type="text" id="Name" name="Name" class="form-control" value="@Model?.Name" />
    </section>
    
    <section>
        <label readonly for="Surname">Surname</label>
        <input readonly type="text" id="Surname" name="Surname" class="form-control" value="@Model?.Surname" />
    </section>

    <section>
        <label readonly for="EmployeeNumber">EmployeeNumber</label>
        <input readonly type="text" id="EmployeeNumber" name="EmployeeNumber" class="form-control" value="@Model?.EmployeeNumber" />
    </section>

    <section>
        <label for="EmployeeRole">EmployeeRole</label>
        <input readonly type="text" id="EmployeeRole" name="EmployeeRole" class="form-control" value="@Model?.EmployeeRole" />
    </section>

    <section>
        <label for="EmailAddress">EmailAddress</label>
        <input readonly type="text" id="EmailAddress" name="EmailAddress" class="form-control" value="@Model?.EmailAddress" />
    </section>

    <section>
        <label for="IsActive">IsActive</label>
        <input readonly type="checkbox" id="IsActive" name="IsActive" asp-for="IsActive" />
    </section>
</section>
