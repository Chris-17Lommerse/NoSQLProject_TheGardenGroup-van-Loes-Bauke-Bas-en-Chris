@using Ticket_System_TheGardenGroup_With_Identity_Framework.ViewModels;
@model Task<List<EmployeeTicketsVm>>
@{
    ViewData["Title"] = "Employees";
}

<partial name="_ErrorMessage" />
<partial name="_WarningMessage" />
<partial name="_SuccessMessage" />
<partial name="_EmbeddedEmployee" />


<div class="text-center">
    <h1>User Management</h1>
    <a href="/Employees/AddEmployee" class="btn btn-primary">Create New Employee</a>

    <table class="table table-info table-hover">
        <partial name="_EmployeeHeader" />
        <tbody>
            @foreach (EmployeeTicketsVm employeeTicketsViewModel in await Model)
            {
                <tr>
                    <td>@employee.EmployeeNumber</td>
                    <td>@employee.EmailAddress</td>
                    <td>@employee.Name</td>
                    <td>@employee.Surname</td>
                    <td>@employee.EmployeeRole</td>
                    <td>@employee.Id</td>
                    <td>
                        <a href="/Employees/ViewEmployee?employeeIdString=@employeeTicketsViewModel.Id">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

