@model Ticket

@{
    ViewData["Title"] = "Edit ticket";
}

<partial name="_ErrorMessage" />
<partial name="_WarningMessage" />
<partial name="_SuccessMessage" />
<partial name="_EmbeddedEmployee" />

<section>

    <a href="/Tickets/index" class="btn btn-primary mb-3">Back to ticket list</a>

    <a href="/Tickets/DeleteTicket?TicketId=@Model?.TicketId" class="btn btn-danger mb-3">Delete ticket</a>

    <form action="/Tickets/UpdateTicket" method="post">
        <p>This form is for updating the employee who is solving this ticket. Ignore this form if you don't need it.</p>
        <partial name="_EmbeddedEmployee" />
        <label for="solvEmployee">Solving Employee Number</label>
        <input type="text" id="solvEmployee" name="SolvingEmployeeNumber" class="form-control" value="@Model?.SolvingEmployee.EmployeeNumber" />

        <label readonly>Name: @Model?.SolvingEmployee.Name</label>
        <label readonly>Email: @Model?.SolvingEmployee.EmailAddress</label>
        <label readonly>Role: @Model?.SolvingEmployee.EmployeeRole</label>

        <button type="submit" name="loadEmployee" value="loadEmployee" class="btn btn-secondary mt-1">Load Employee</button>
    </form>
    <h2>-----</h2>
    <form action="/Tickets/UpdateTicket" method="post">
        <section>
            <label hidden for="TicketId">Ticket id</label>
            <input hidden type="text" id="TicketId" name="TicketId" class="form-control" value="@Model?.TicketId" />
        </section>

        <section>
            <label readonly for="creationTime">Creation time</label>
            <input readonly type="datetime" id="creationTime" name="CreationTime" class="form-control" value="@Model?.CreationTime" />
        </section>

        <section>
            <label readonly for="TicketStatus">Ticket Status</label>
            <input readonly type="text" id="TicketStatus" name="TicketStatus" class="form-control" value="@Model?.TicketStatus" />
        </section>

        <section>
            <label for="TicketName">Ticket name</label>
            <input type="text" id="TicketName" name="TicketName" class="form-control" value="@Model?.TicketName" />
        </section>

        <section>
            <label for="Description">Ticket Description</label>
            <input type="text" id="Description" name="Description" class="form-control" value="@Model?.Description" />
        </section>

        <section>
            <label for="TicketEscalationDescription">Ticket Description</label>
            <input type="text" id="TicketEscalationDescription" name="TicketEscalationDescription" class="form-control" value="@Model?.TicketEscalationDescription" />
        </section>

        <section>
            <label readonly for="IsSolved">Is ticket solved?</label>
            <input type="checkbox" id="IsSolved" name="IsSolved" value="@Model?.IsSolved" />
        </section>

        <section>
            <label for="ticketPriority">Ticket priority (only ds_e)</label>
            <input type="text" id="ticketPriority" name="ticketPriority" class="form-control" value="@Model?.Priority" />
        </section>

        <section>
            <label readonly for="reportEmployee">Reporting employee</label>
            <input readonly type="text" id="reportEmployee" name="reportEmployee" class="form-control" value="@Model?.ReportingEmployee.Name" />
        </section>

        <section>
            <label readonly for="solvEmployee">Solving Employee Number</label>
            <input readonly type="text" id="solvEmployee" name="SolvingEmployeeNumber" class="form-control" value="@Model?.SolvingEmployee.EmployeeNumber" />

            <label readonly for="SolvingEmployeeName">Name</label>
            <input readonly id="SolvingEmployeeName" type="text" class="form-control" value="@Model?.SolvingEmployee.Name" />

            <label readonly for="SolvingEmployeeEmail">Email</label>
            <input readonly id="SolvingEmployeeEmail" type="text" class="form-control" value="@Model?.SolvingEmployee.EmailAddress" />

            <label readonly for="SolvingEmployeeRole">Role</label>
            <input readonly id="SolvingEmployeeRole" type="text" class="form-control" value="@Model?.SolvingEmployee.EmployeeRole" />
        </section>

        <button type="submit" name="updateTicket" class="btn btn-primary">Update ticket</button>

    </form>
</section>

